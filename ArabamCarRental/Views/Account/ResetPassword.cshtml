@{
    ViewBag.Title = "Yeni Şifre Belirle";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string token = ViewBag.Token as string ?? "";
}

@section Styles {
<style>
:root { --fire:#d4500a; --amber:#f0a500; --black:#0a0a08; --white:#e8e0d0; --muted:rgba(232,224,208,0.5); }
.auth-page { min-height:calc(100vh - 120px); display:flex; align-items:center; background:#0a0a08; padding:2rem 0; position:relative; overflow:hidden; }
.auth-page::before { content:''; position:absolute; bottom:-10%; right:5%; width:600px; height:600px; border-radius:50%; background:radial-gradient(circle, rgba(212,80,10,0.12) 0%, transparent 65%); pointer-events:none; }
.auth-card { background:#1a1a12; border:1px solid rgba(212,80,10,0.18); border-radius:20px; overflow:hidden; box-shadow:0 30px 80px rgba(0,0,0,0.6); display:flex; min-height:440px; position:relative; z-index:1; }
.auth-left { background:linear-gradient(160deg, #8a2a00 0%, #d4500a 40%, #1a1a12 100%); padding:3rem 2rem; display:flex; flex-direction:column; justify-content:center; color:#fff; min-width:280px; position:relative; overflow:hidden; }
.auth-left::before { content:''; position:absolute; width:300px; height:300px; background:rgba(240,165,0,0.08); border-radius:50%; top:-80px; right:-90px; }
.auth-left::after  { content:''; position:absolute; width:200px; height:200px; background:rgba(0,0,0,0.15); border-radius:50%; bottom:-60px; left:-60px; }
.auth-left h2 { font-family:'Bebas Neue',sans-serif; font-size:2rem; letter-spacing:.04em; margin-bottom:.7rem; line-height:1.2; position:relative; z-index:1; }
.auth-left p  { font-size:.87rem; opacity:.85; line-height:1.6; margin-bottom:1.8rem; position:relative; z-index:1; }
.auth-left .feat { display:flex; align-items:center; gap:9px; font-size:.85rem; margin-bottom:.55rem; opacity:.9; position:relative; z-index:1; }
.auth-left .feat i { color:var(--amber); }
.auth-right { padding:2.8rem 2.5rem; display:flex; flex-direction:column; justify-content:center; flex:1; }
.auth-right h3 { font-family:'Bebas Neue',sans-serif; font-size:1.9rem; color:var(--white); margin-bottom:.3rem; letter-spacing:.04em; }
.auth-right .sub { color:var(--muted); font-size:.88rem; margin-bottom:1.8rem; }
.form-label { font-size:.8rem; text-transform:uppercase; letter-spacing:.08em; color:var(--muted); margin-bottom:.4rem; display:block; }
.form-control-dark { background:#0f0f0a; border:1px solid rgba(212,80,10,0.2); border-radius:10px; color:var(--white); font-size:.92rem; padding:.65rem 1rem; width:100%; outline:none; transition:border-color .2s; }
.form-control-dark:focus { border-color:var(--fire); }
.form-control-dark::placeholder { color:rgba(232,224,208,0.2); }
.input-wrap { position:relative; }
.toggle-pw { position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none; color:var(--muted); cursor:pointer; padding:0; font-size:1rem; }
.toggle-pw:hover { color:var(--fire); }
.pw-strength { height:4px; border-radius:2px; margin-top:6px; transition:all .3s; background:#333; }
.pw-strength.weak   { background:#ef4444; width:30%; }
.pw-strength.medium { background:#f0a500; width:65%; }
.pw-strength.strong { background:#34d399; width:100%; }
.pw-hint { font-size:.75rem; color:var(--muted); margin-top:4px; }
.btn-engine { background:linear-gradient(135deg,#d4500a,#a83d08); border:none; border-radius:10px; color:#fff; font-size:.92rem; font-weight:700; padding:.75rem 2rem; width:100%; cursor:pointer; letter-spacing:.04em; transition:opacity .2s,transform .1s; margin-top:.5rem; }
.btn-engine:hover { opacity:.9; transform:translateY(-1px); }
.auth-link { color:var(--fire); text-decoration:none; font-weight:600; }
.auth-link:hover { color:var(--amber); }
.hint-text { color:var(--muted); font-size:.83rem; text-align:center; margin-top:1.2rem; }
@@media(max-width:640px){ .auth-left { display:none; } }
</style>
}

<div class="auth-page">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-9 col-xl-8">

        @if (TempData["ErrorMessage"] != null)
        {
          <div class="alert alert-danger mb-3">@TempData["ErrorMessage"]</div>
        }

        <div class="auth-card">
          <div class="auth-left">
            <h2>Yeni Şifre</h2>
            <p>Güçlü bir şifre seçerek hesabını koruma altına al.</p>
            <div class="feat"><i class="bi bi-key-fill"></i> En az 6 karakter</div>
            <div class="feat"><i class="bi bi-check2-circle"></i> Tek kullanımlık bağlantı</div>
            <div class="feat"><i class="bi bi-lock-fill"></i> Şifreli depolama</div>
          </div>

          <div class="auth-right">
            <h3>Yeni Şifre Belirle</h3>
            <p class="sub">Şifrenizi girdikten sonra giriş yapabilirsiniz.</p>

            @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post))
            {
              @Html.AntiForgeryToken()
              <input type="hidden" name="token" value="@token" />

              <div class="mb-3">
                <label class="form-label"><i class="bi bi-lock me-1"></i>Yeni Şifre</label>
                <div class="input-wrap">
                  <input type="password" name="NewPassword" id="newPassword"
                         class="form-control-dark" placeholder="En az 6 karakter"
                         required minlength="6" oninput="checkStrength(this.value)" />
                  <button type="button" class="toggle-pw" onclick="togglePw('newPassword',this)">
                    <i class="bi bi-eye"></i>
                  </button>
                </div>
                <div class="pw-strength" id="pwStrength"></div>
                <div class="pw-hint" id="pwHint"></div>
              </div>

              <div class="mb-3">
                <label class="form-label"><i class="bi bi-lock-fill me-1"></i>Şifre Tekrar</label>
                <div class="input-wrap">
                  <input type="password" name="ConfirmPassword" id="confirmPassword"
                         class="form-control-dark" placeholder="Şifreyi tekrar girin" required />
                  <button type="button" class="toggle-pw" onclick="togglePw('confirmPassword',this)">
                    <i class="bi bi-eye"></i>
                  </button>
                </div>
              </div>

              <button type="submit" class="btn-engine" id="submitBtn">
                <i class="bi bi-check-circle me-2"></i>Şifremi Güncelle
              </button>
            }

            <p class="hint-text">
              <a href="@Url.Action("Login","Account")" class="auth-link">
                <i class="bi bi-arrow-left me-1"></i>Giriş sayfasına dön
              </a>
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

@section Scripts {
<script>
function togglePw(id, btn) {
  var inp = document.getElementById(id);
  var icon = btn.querySelector('i');
  if (inp.type === 'password') {
    inp.type = 'text';
    icon.className = 'bi bi-eye-slash';
  } else {
    inp.type = 'password';
    icon.className = 'bi bi-eye';
  }
}

function checkStrength(val) {
  var bar  = document.getElementById('pwStrength');
  var hint = document.getElementById('pwHint');
  if (!val) { bar.className = 'pw-strength'; hint.textContent = ''; return; }
  var score = 0;
  if (val.length >= 6)  score++;
  if (val.length >= 10) score++;
  if (/[A-Z]/.test(val)) score++;
  if (/[0-9]/.test(val)) score++;
  if (/[^A-Za-z0-9]/.test(val)) score++;
  if (score <= 2) { bar.className = 'pw-strength weak';   hint.textContent = 'Zayıf şifre'; }
  else if (score <= 3) { bar.className = 'pw-strength medium'; hint.textContent = 'Orta güç'; }
  else { bar.className = 'pw-strength strong'; hint.textContent = 'Güçlü şifre ✓'; }
}
</script>
}
