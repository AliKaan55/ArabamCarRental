@{
    ViewBag.Title = "Şifremi Unuttum";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
<style>
:root { --fire:#d4500a; --amber:#f0a500; --black:#0a0a08; --white:#e8e0d0; --muted:rgba(232,224,208,0.5); }
.auth-page { min-height:calc(100vh - 120px); display:flex; align-items:center; background:#0a0a08; padding:2rem 0; position:relative; overflow:hidden; }
.auth-page::before { content:''; position:absolute; bottom:-10%; right:5%; width:600px; height:600px; border-radius:50%; background:radial-gradient(circle, rgba(212,80,10,0.12) 0%, transparent 65%); pointer-events:none; }
.auth-card { background:#1a1a12; border:1px solid rgba(212,80,10,0.18); border-radius:20px; overflow:hidden; box-shadow:0 30px 80px rgba(0,0,0,0.6); display:flex; min-height:420px; position:relative; z-index:1; }
.auth-left { background:linear-gradient(160deg, #8a2a00 0%, #d4500a 40%, #1a1a12 100%); padding:3rem 2rem; display:flex; flex-direction:column; justify-content:center; color:#fff; min-width:280px; position:relative; overflow:hidden; }
.auth-left::before { content:''; position:absolute; width:300px; height:300px; background:rgba(240,165,0,0.08); border-radius:50%; top:-80px; right:-90px; }
.auth-left::after  { content:''; position:absolute; width:200px; height:200px; background:rgba(0,0,0,0.15); border-radius:50%; bottom:-60px; left:-60px; }
.auth-left h2 { font-family:'Bebas Neue',sans-serif; font-size:2rem; letter-spacing:.04em; margin-bottom:.7rem; line-height:1.2; position:relative; z-index:1; }
.auth-left p  { font-size:.87rem; opacity:.85; line-height:1.6; margin-bottom:1.8rem; position:relative; z-index:1; }
.auth-left .feat { display:flex; align-items:center; gap:9px; font-size:.85rem; margin-bottom:.55rem; opacity:.9; position:relative; z-index:1; }
.auth-left .feat i { color:var(--amber); }
.auth-right { padding:2.8rem 2.5rem; display:flex; flex-direction:column; justify-content:center; flex:1; }
.auth-right h3 { font-family:'Bebas Neue',sans-serif; font-size:1.9rem; color:var(--white); margin-bottom:.3rem; letter-spacing:.04em; }
.auth-right .sub { color:var(--muted); font-size:.88rem; margin-bottom:1.8rem; }
.form-label { font-size:.8rem; text-transform:uppercase; letter-spacing:.08em; color:var(--muted); margin-bottom:.4rem; display:block; }
.form-control-dark { background:#0f0f0a; border:1px solid rgba(212,80,10,0.2); border-radius:10px; color:var(--white); font-size:.92rem; padding:.65rem 1rem; width:100%; outline:none; transition:border-color .2s; }
.form-control-dark:focus { border-color:var(--fire); }
.form-control-dark::placeholder { color:rgba(232,224,208,0.2); }
.btn-engine { background:linear-gradient(135deg,#d4500a,#a83d08); border:none; border-radius:10px; color:#fff; font-size:.92rem; font-weight:700; padding:.75rem 2rem; width:100%; cursor:pointer; letter-spacing:.04em; transition:opacity .2s,transform .1s; margin-top:.5rem; }
.btn-engine:hover { opacity:.9; transform:translateY(-1px); }
.auth-link { color:var(--fire); text-decoration:none; font-weight:600; }
.auth-link:hover { color:var(--amber); }
.hint-text { color:var(--muted); font-size:.83rem; text-align:center; margin-top:1.2rem; }
.dev-box { background:rgba(240,165,0,0.08); border:1px solid rgba(240,165,0,0.3); border-radius:10px; padding:1rem 1.2rem; margin-top:1rem; font-size:.82rem; color:var(--amber); word-break:break-all; }
.dev-box strong { display:block; margin-bottom:.4rem; font-size:.75rem; text-transform:uppercase; letter-spacing:.07em; }
@@media(max-width:640px){ .auth-left { display:none; } }
</style>
}

<div class="auth-page">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-9 col-xl-8">

        @if (TempData["ErrorMessage"] != null)
        {
          <div class="alert alert-danger mb-3">@TempData["ErrorMessage"]</div>
        }
        @if (TempData["SuccessMessage"] != null)
        {
          <div class="alert alert-success mb-3">@TempData["SuccessMessage"]</div>
        }

        <div class="auth-card">
          <!-- Sol panel -->
          <div class="auth-left">
            <h2>Şifreni Sıfırla</h2>
            <p>E-posta adresini gir, sana sıfırlama bağlantısı gönderelim.</p>
            <div class="feat"><i class="bi bi-shield-lock-fill"></i> Güvenli sıfırlama</div>
            <div class="feat"><i class="bi bi-clock"></i> 1 saat geçerli bağlantı</div>
            <div class="feat"><i class="bi bi-envelope-check"></i> E-posta ile teslim</div>
          </div>

          <!-- Sağ panel -->
          <div class="auth-right">
            <h3>Şifremi Unuttum</h3>
            <p class="sub">Kayıtlı e-posta adresinizi girin.</p>

            @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post))
            {
              @Html.AntiForgeryToken()
              <div class="mb-3">
                <label class="form-label"><i class="bi bi-envelope me-1"></i>E-posta Adresi</label>
                <input type="email" name="Email" class="form-control-dark"
                       placeholder="ornek@mail.com" required autofocus />
              </div>
              <button type="submit" class="btn-engine">
                <i class="bi bi-send me-2"></i>Sıfırlama Bağlantısı Gönder
              </button>
            }

            @* Geliştirme ortamı: gerçek e-posta gönderilemediğinde linki göster *@
            @if (TempData["DevResetLink"] != null)
            {
              <div class="dev-box">
                <strong>⚙ Geliştirme Modu — Sıfırlama Linki:</strong>
                <a href="@TempData["DevResetLink"]" class="auth-link">@TempData["DevResetLink"]</a>
              </div>
            }

            <p class="hint-text">
              Şifrenizi hatırladınız mı?
              <a href="@Url.Action("Login","Account")" class="auth-link">Giriş Yap</a>
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>
