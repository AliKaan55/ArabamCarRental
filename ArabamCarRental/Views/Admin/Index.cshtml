@model IEnumerable<ArabamCarRental.Models.Car>

@{
    ViewBag.Title = "Sistemdeki Araçlar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        :root {
            --fire: #d4500a;
            --amber: #f0a500;
            --black: #0a0a08;
            --white: #e8e0d0;
            --muted: rgba(232,224,208,0.5);
        }

        body {
            background: var(--black);
            color: var(--white);
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 2rem 0;
            padding-bottom: 1rem;
            border-bottom: 1px solid rgba(212,80,10,0.2);
        }

        .page-title {
            font-family: 'Bebas Neue', 'Arial Black', sans-serif;
            font-size: 2rem;
            color: var(--white);
            margin: 0;
            letter-spacing: 1px;
        }

        /* Üst Butonlar */
        .top-btn {
            border-radius: 8px;
            padding: 0.6rem 1.2rem;
            font-size: 0.9rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            margin-left: 0.5rem;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-add {
            background: var(--fire);
            color: #fff;
            border: 1px solid var(--fire);
            box-shadow: 0 4px 10px rgba(212,80,10,0.2);
        }

            .btn-add:hover {
                background: #b84008;
                color: #fff;
                box-shadow: 0 6px 15px rgba(212,80,10,0.4);
                transform: translateY(-2px);
            }

        .btn-history {
            background: rgba(56,189,248,0.1);
            color: #38bdf8;
            border: 1px solid #38bdf8;
        }

            .btn-history:hover {
                background: #38bdf8;
                color: #000;
            }

        .btn-reviews {
            background: rgba(250,204,21,0.1);
            color: #facc15;
            border: 1px solid #facc15;
        }

            .btn-reviews:hover {
                background: #facc15;
                color: #000;
            }

        .btn-customers {
            background: rgba(148,163,184,0.1);
            color: #94a3b8;
            border: 1px solid #94a3b8;
        }

            .btn-customers:hover {
                background: #94a3b8;
                color: #000;
            }

        .btn-logout {
            background: rgba(239,68,68,0.1);
            color: #ef4444;
            border: 1px solid #ef4444;
        }

            .btn-logout:hover {
                background: #ef4444;
                color: #fff;
            }

        /* Karanlık Tablo Kartı */
        .admin-table-card {
            background: #1a1a12;
            border: 1px solid rgba(212,80,10,0.18);
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
            overflow-x: auto;
        }

        .custom-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 8px;
        }

            .custom-table th {
                background: transparent;
                color: var(--amber);
                font-weight: 600;
                text-transform: uppercase;
                font-size: 0.85rem;
                padding: 1rem;
                border-bottom: 1px solid rgba(212,80,10,0.3);
            }

            .custom-table td {
                background: rgba(255,255,255,0.02);
                padding: 1rem;
                vertical-align: middle;
                color: var(--white);
                border-top: 1px solid transparent;
                border-bottom: 1px solid transparent;
            }

            .custom-table tr:hover td {
                background: rgba(212,80,10,0.05);
                border-color: rgba(212,80,10,0.1);
            }

            .custom-table td:first-child {
                border-top-left-radius: 8px;
                border-bottom-left-radius: 8px;
            }

            .custom-table td:last-child {
                border-top-right-radius: 8px;
                border-bottom-right-radius: 8px;
            }

        .status-badge {
            padding: 0.4rem 0.8rem;
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .status-available {
            background: rgba(34,197,94,0.1);
            color: #22c55e;
            border: 1px solid #22c55e;
        }

        .status-rented {
            background: rgba(239,68,68,0.1);
            color: #ef4444;
            border: 1px solid #ef4444;
        }

        .price-text {
            color: #22c55e;
            font-weight: 700;
            font-size: 1.05rem;
        }

        /* Aksiyon Butonları */
        .btn-action {
            padding: 0.4rem 0.8rem;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
        }

        .btn-edit {
            background: rgba(59,130,246,0.1);
            color: #3b82f6;
            border: 1px solid #3b82f6;
        }

            .btn-edit:hover {
                background: #3b82f6;
                color: #fff;
            }

        .btn-delete {
            background: rgba(239,68,68,0.1);
            color: #ef4444;
            border: 1px solid #ef4444;
            margin-left: 0.3rem;
        }

            .btn-delete:hover {
                background: #ef4444;
                color: #fff;
            }
    </style>
}

<div class="container">
    <div class="page-header">
        <h2 class="page-title">Sistemdeki Araçlar</h2>
        <div class="header-actions">
            <a href="/Admin/Create" class="top-btn btn-add"><i class="fa-solid fa-plus"></i> Yeni Araç Ekle</a>
            <a href="/Admin/Rentals" class="top-btn btn-history"><i class="fa-solid fa-clock-rotate-left"></i> Kiralama Geçmişi</a>
            <a href="/Admin/Reviews" class="top-btn btn-reviews"><i class="fa-solid fa-star"></i> Yorumlar</a>
            <a href="/Admin/Customers" class="top-btn btn-customers"><i class="fa-solid fa-users"></i> Müşteriler</a>
            <a href="/Account/Logout" class="top-btn btn-logout"><i class="fa-solid fa-right-from-bracket"></i> Çıkış Yap</a>
        </div>
    </div>

    <div class="admin-table-card">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Marka</th>
                    <th>Model</th>
                    <th>Plaka</th>
                    <th>Günlük Fiyat</th>
                    <th>Müsaitlik</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var car in Model)
                {
                    <tr>
                        <td style="color:var(--muted);">#@car.CarID</td>
                        <td class="fw-bold">@car.Brand</td>
                        <td>@car.Model</td>
                        <td><span style="background:#111; padding:0.3rem 0.6rem; border:1px solid #333; border-radius:4px; font-family:monospace;">@(string.IsNullOrEmpty(car.LicensePlate) ? "YOK" : car.LicensePlate)</span></td>
                        <td class="price-text">₺@car.DailyPrice.ToString("N2")</td>
                        <td>
                            @if (car.IsAvailable)
                            {
                                <span class="status-badge status-available">Müsait</span>
                            }
                            else
                            {
                                <span class="status-badge status-rented">Kirada</span>
                            }
                        </td>
                        <td>
                            <a href="/Admin/Edit/@car.CarID" class="btn-action btn-edit"><i class="fa-solid fa-pen-to-square"></i> Düzenle</a>
                            <a href="/Admin/Delete/@car.CarID" class="btn-action btn-delete" onclick="return confirm('Bu aracı silmek istediğinize emin misiniz?');"><i class="fa-solid fa-trash"></i> Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>